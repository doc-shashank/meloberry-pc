<Project>
  <PropertyGroup>
    <Version>1.1.1</Version>
    <VersionPrefix>1.1.1</VersionPrefix>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <InformationalVersion>1.1.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Meloberry PC</Product>
    <Company>Meloberry</Company>
    <Description>Lightweight .NET 10 Win32 + WebView2 desktop companion for initializing Meloberry workspaces, authoring AI agent prompts, exporting AGENTS.md schemas, and viewing study WebApps.</Description>
    <SelfUpdateRepoOwner>doc-shashank</SelfUpdateRepoOwner>
    <SelfUpdateRepoName>meloberry-pc</SelfUpdateRepoName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <NuGetAudit>false</NuGetAudit>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="AppName" Value="$(Company)" />
    <AssemblyMetadata Include="ExecutableName" Value="mby-pc" />
    <AssemblyMetadata Include="SelfUpdateRepoOwner" Value="$(SelfUpdateRepoOwner)" />
    <AssemblyMetadata Include="SelfUpdateRepoName" Value="$(SelfUpdateRepoName)" />
  </ItemGroup>
</Project>
